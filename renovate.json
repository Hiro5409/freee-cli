{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "description": "Keep the TypeScript 7-compatible OpenAPI generator on its prerelease channel and require review before opening an update PR.",
      "matchPackageNames": ["@hey-api/openapi-ts"],
      "allowedVersions": "/^0\\.0\\.0-next-/",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Preserve dependency overrides as repository compatibility decisions.",
      "matchDepTypes": ["overrides"],
      "enabled": false
    }
  ]
}
