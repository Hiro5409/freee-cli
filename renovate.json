{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly",
    "group:allNonMajor",
    "group:vitePlus"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 2,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep the TypeScript 7-compatible OpenAPI generator on its prerelease channel and require review before opening an update PR.",
      "matchPackageNames": ["@hey-api/openapi-ts"],
      "groupName": null,
      "allowedVersions": "/^0\\.0\\.0-next-/",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Preserve compatibility overrides except the core package updated with Vite+.",
      "matchDepTypes": ["overrides"],
      "matchPackageNames": ["!@voidzero-dev/vite-plus-core"],
      "enabled": false
    }
  ]
}
