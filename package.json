{
  "name": "freee-cli",
  "version": "0.12.1",
  "description": "Agent-friendly command line interface for the freee API.",
  "keywords": [
    "accounting",
    "bun",
    "cli",
    "freee",
    "invoice",
    "oauth2"
  ],
  "homepage": "https://github.com/Hiro5409/freee-cli#readme",
  "bugs": {
    "url": "https://github.com/Hiro5409/freee-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiro5409/freee-cli.git"
  },
  "bin": {
    "freee": "bin/freee"
  },
  "files": [
    "bin",
    "skills",
    "src",
    "!src/types/freee/types.gen.ts",
    "!src/types/freee-invoice/types.gen.ts",
    "!src/types/freee-hr/types.gen.ts",
    "!src/types/**/msw.gen.ts",
    "!src/**/test-fixtures.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --compile --outfile freee",
    "test": "bun test",
    "check": "bun run check:generated && bun run --parallel --no-exit-on-error check:format check:types lint knip test check:package",
    "check:format": "bun fmt --check",
    "check:types": "bun check --no-script",
    "lint": "oxlint",
    "knip": "knip",
    "check:package": "publint run --pack bun",
    "check:generated": "bun run generate-types && git diff --exit-code HEAD -- src/types && test -z \"$(git ls-files --others --exclude-standard -- src/types)\"",
    "prepublishOnly": "bun run check",
    "api-schema:check": "bun scripts/check-api-schema.ts",
    "generate-types": "openapi-ts --file openapi-ts.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@valibot/to-json-schema": "^1.8.0",
    "gunshi": "1.0.0-rc.11",
    "ky": "2.2.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@mswjs/interceptors": "0.45.12",
    "@types/bun": "1.4.5",
    "@typescript-eslint/types": "8.73.0",
    "knip": "6.46.1",
    "msw": "3.0.7",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "publint": "0.3.25"
  },
  "overrides": {
    "js-yaml": "5.5.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
