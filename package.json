{
  "name": "freee-cli",
  "version": "0.0.0",
  "description": "Agent-friendly command line interface for the freee API.",
  "keywords": [
    "accounting",
    "bun",
    "cli",
    "freee",
    "invoice",
    "oauth2"
  ],
  "homepage": "https://github.com/Hiro5409/freee-cli#readme",
  "bugs": {
    "url": "https://github.com/Hiro5409/freee-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiro5409/freee-cli.git"
  },
  "bin": {
    "freee": "bin/freee"
  },
  "files": [
    "bin",
    "docs",
    "scripts/setup.sh",
    "skills",
    "src",
    "!src/types/freee/types.gen.ts",
    "!src/types/freee-invoice/types.gen.ts",
    "!src/types/freee-hr/types.gen.ts",
    "!src/types/**/msw.gen.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --compile --outfile freee",
    "test": "bun test",
    "check": "bun run --parallel --no-exit-on-error check:lint check:format check:lint-rules check:knip typecheck",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:lint-rules": "bun test lint-rules/plugin.test.ts",
    "check:knip": "knip",
    "typecheck": "tsc --noEmit",
    "secrets": "gitleaks git --no-banner --redact .",
    "check:package": "publint run --pack bun",
    "prepublishOnly": "bun run check && bun test && bun run check:package",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "generate-types": "openapi-ts --file openapi-ts.config.ts",
    "check-api-update": "bash scripts/check-api-update.sh",
    "check-api-update:apply": "bun run generate-types && bun run typecheck && bash scripts/update-api-baselines.sh"
  },
  "dependencies": {
    "gunshi": "^0.37.1",
    "p-limit": "^7.3.1",
    "yoctocolors": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/types": "^8.66.0",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11"
}
