{
  "name": "freee-cli",
  "version": "0.6.0",
  "description": "Agent-friendly command line interface for the freee API.",
  "keywords": [
    "accounting",
    "bun",
    "cli",
    "freee",
    "invoice",
    "oauth2"
  ],
  "homepage": "https://github.com/Hiro5409/freee-cli#readme",
  "bugs": {
    "url": "https://github.com/Hiro5409/freee-cli/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiro5409/freee-cli.git"
  },
  "bin": {
    "freee": "bin/freee"
  },
  "files": [
    "bin",
    "skills",
    "src",
    "!src/types/freee/types.gen.ts",
    "!src/types/freee-invoice/types.gen.ts",
    "!src/types/freee-hr/types.gen.ts",
    "!src/types/**/msw.gen.ts",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    "./experimental/web": "./src/plugins/web-operations/bookkeeping-browser.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --compile --outfile freee",
    "test": "bun test",
    "check": "bun run check:generated && bun run --parallel --no-exit-on-error lint format:check knip typecheck test check:package",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "check:package": "publint run --pack bun",
    "check:generated": "bun run generate-types && git diff --exit-code HEAD -- src/types && test -z \"$(git ls-files --others --exclude-standard -- src/types)\"",
    "prepublishOnly": "bun run check",
    "api-schema:check": "bun scripts/check-api-schema.ts",
    "generate-types": "openapi-ts --file openapi-ts.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "gunshi": "^0.37.1",
    "valibot": "^1.4.2",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.0.0-next-20260729142554",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/types": "^8.66.0",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
